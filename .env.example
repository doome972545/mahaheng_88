# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#   cp .env.example .env
# CRA อ่าน .env ตอน start เท่านั้น — แก้ระหว่าง npm start รันอยู่ต้อง restart

# ── Backend API ──────────────────────────────────────────────
# ปลายทางของ /api/auth/* และ /api/num/* (คนละ repo กับตัวนี้)
REACT_APP_SERVER_DOMIN=https://mycorsproxy-lottery.vercel.app

# ── Build flags ──────────────────────────────────────────────
SKIP_PREFLIGHT_CHECK=true
DISABLE_NEW_JSX_TRANSFORM=true

# ── Firebase Realtime Database ───────────────────────────────
# ใช้กับการ์ด "อัพเดทล่าสุด" อย่างเดียว ส่วนอื่นของแอปวิ่งผ่าน backend ข้างบน
# ปล่อยว่างทั้งบล็อกได้ แอปยังทำงานปกติ การ์ด realtime จะปิดตัวเองและขึ้น
# ป้าย "ยังไม่ได้ตั้งค่า Firebase" แทน (ดู firebaseEnabled ใน src/config/firebase.js)
#
# หาค่าได้ที่ Firebase console:
#   ⚙️ Project settings > General > Your apps > SDK setup and configuration > Config
#   ถ้าหัวข้อ Your apps ว่าง ให้กดไอคอน </> ลงทะเบียน Web app ก่อน
#
# ต้องทำในคอนโซลด้วย 2 อย่าง ไม่งั้นอ่าน/เขียนไม่ผ่าน:
#   1. Authentication > Sign-in method > Anonymous > Enable
#   2. Realtime Database > Rules > วางเนื้อจาก database.rules.json > Publish
#
# หมายเหตุ: ค่าพวกนี้ถูก inline เข้า bundle ตอน build และเปิดดูได้จากเบราว์เซอร์
# เป็นเรื่องปกติของ Firebase web — apiKey ไม่ใช่ความลับ ตัวที่กันข้อมูลจริงคือ rules
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
